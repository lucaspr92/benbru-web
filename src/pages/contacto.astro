---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, buildWhatsAppLink } from '../content/site';
import { deliveryZones } from '../content/delivery';
import { MessageCircle, MapPin, Clock, ArrowUpRight, HelpCircle } from 'lucide-react';
import { InstagramIcon } from '../components/ui/InstagramIcon';
---

<BaseLayout 
  title="Contacto & Ubicación — BenBru Panadería & Cafetería"
  description="Contactanos directamente por WhatsApp o Instagram. Visitá nuestro local en Av. 2 y Los Alelíes, Costa del Este."
>

  <!-- Hero Section -->
  <section class="bg-[#3F2B1F] text-[#E9E3DD] py-16 sm:py-20 border-b border-[#5D4E44]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-[#E9E3DD]">
        Contacto &amp; Ubicación
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#E7E1D9]/80 max-w-2xl mx-auto leading-relaxed">
        Respondemos al instante por WhatsApp y compartimos el día a día del obrador en Instagram. Sin intermediarios ni formularios demorados.
      </p>
    </div>
  </section>

  <!-- Main Direct Contact Channels -->
  <section class="py-20 bg-[#E9E3DD]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- WhatsApp Card -->
        <div class="bg-[#F4EFEB] rounded-3xl p-8 sm:p-10 border-2 border-[#25D366]/40 shadow-md hover:shadow-xl transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-14 h-14 rounded-2xl bg-[#25D366] text-white flex items-center justify-center shadow-sm">
                <MessageCircle className="w-8 h-8 fill-current stroke-none" />
              </div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#25D366]/15 text-[#1b8c43]">
                <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
                En línea
              </span>
            </div>

            <h2 class="font-display text-2xl sm:text-3xl font-bold text-[#3F2B1F] mb-2">
              WhatsApp Oficial
            </h2>
            <p class="text-sm text-[#5D4E44] leading-relaxed mb-6">
              Canal directo para consultar la disponibilidad del día, realizar pedidos con retiro en local o coordinar envíos a domicilio en el Partido de La Costa.
            </p>

            <div class="p-4 rounded-2xl bg-[#E9E3DD] text-[#3F2B1F] font-mono text-base font-bold text-center mb-6">
              {site.contact.whatsappDisplay}
            </div>
          </div>

          <a
            href={buildWhatsAppLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 py-4 px-6 bg-[#25D366] hover:bg-[#20ba5a] text-white font-bold rounded-full shadow-md hover:scale-102 active:scale-98 transition-all text-base"
          >
            <MessageCircle className="w-5 h-5 fill-current stroke-none" />
            <span>Chatear por WhatsApp</span>
            <ArrowUpRight className="w-4 h-4 ml-1" />
          </a>
        </div>

        <!-- Instagram Card -->
        <div class="bg-[#F4EFEB] rounded-3xl p-8 sm:p-10 border-2 border-[#A66B38]/30 shadow-md hover:shadow-xl transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-14 h-14 rounded-2xl bg-[#3F2B1F] text-[#E9E3DD] flex items-center justify-center shadow-sm">
                <InstagramIcon className="w-8 h-8" />
              </div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#A66B38]/15 text-[#8C5528]">
                Comunidad
              </span>
            </div>

            <h2 class="font-display text-2xl sm:text-3xl font-bold text-[#3F2B1F] mb-2">
              Instagram
            </h2>
            <p class="text-sm text-[#5D4E44] leading-relaxed mb-6">
              Seguinos para ver los horneados diarios, historias en vivo, tandas de medialunas y novedades de la temporada en Costa del Este.
            </p>

            <div class="p-4 rounded-2xl bg-[#E9E3DD] text-[#3F2B1F] font-display text-lg font-bold text-center mb-6">
              {site.contact.instagramHandle}
            </div>
          </div>

          <a
            href={site.contact.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 py-4 px-6 bg-[#3F2B1F] hover:bg-[#5D4E44] text-[#E9E3DD] font-bold rounded-full shadow-md hover:scale-102 active:scale-98 transition-all text-base"
          >
            <InstagramIcon className="w-5 h-5" />
            <span>Ver perfil en Instagram</span>
            <ArrowUpRight className="w-4 h-4 ml-1" />
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- Location & Map Section -->
  <section class="py-20 bg-[#E7E1D9] border-y border-[#87786F]/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#F4EFEB] rounded-3xl p-8 sm:p-12 border border-[#87786F]/25 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <div class="lg:col-span-5 space-y-6">
            <span class="text-xs uppercase tracking-widest text-[#A66B38] font-bold">
              Ubicación Física
            </span>
            <h2 class="font-display text-3xl font-bold text-[#3F2B1F]">
              Encontranos en Costa del Este
            </h2>
            <p class="text-sm text-[#5D4E44] leading-relaxed">
              Vení a disfrutar del aroma a café y masa recién horneada en un entorno natural rodeado de pinos.
            </p>

            <div class="space-y-4 pt-2">
              <div class="flex items-start gap-3">
                <MapPin className="w-5 h-5 text-[#A66B38] shrink-0 mt-0.5" />
                <div>
                  <h3 class="font-bold text-[#3F2B1F]">{site.location.street}</h3>
                  <p class="text-xs text-[#5D4E44]">{site.location.city}, Provincia de Buenos Aires</p>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <Clock className="w-5 h-5 text-[#A66B38] shrink-0 mt-0.5" />
                <div>
                  <h3 class="font-bold text-[#3F2B1F]">Horario</h3>
                  <p class="text-xs text-[#5D4E44]">{site.location.hoursText}</p>
                </div>
              </div>
            </div>

            <div class="pt-4">
              <a
                href={site.location.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3.5 bg-[#3F2B1F] text-[#E9E3DD] hover:bg-[#5D4E44] rounded-full text-sm font-bold shadow-sm transition-all"
              >
                <MapPin className="w-4 h-4 text-[#A66B38]" />
                <span>Abrir en Google Maps</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-7 h-80 sm:h-96 rounded-2xl overflow-hidden border border-[#87786F]/30 bg-[#E7E1D9] shadow-inner">
            <iframe
              src={site.location.embedMapUrl}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación BenBru Costa del Este"
              class="w-full h-full grayscale-[20%] contrast-[1.05]"
            ></iframe>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <section class="py-20 bg-[#E9E3DD]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs uppercase tracking-widest text-[#A66B38] font-bold">
          Respuestas Rápidas
        </span>
        <h2 class="font-display text-3xl font-bold text-[#3F2B1F] mt-2">
          Preguntas Frecuentes
        </h2>
      </div>

      <div class="space-y-4">
        <div class="bg-[#F4EFEB] p-6 rounded-2xl border border-[#87786F]/20">
          <h3 class="font-bold text-base text-[#3F2B1F] flex items-center gap-2">
            <HelpCircle className="w-4 h-4 text-[#A66B38] shrink-0" />
            <span>¿Con cuánta anticipación debo hacer un encargo especial?</span>
          </h3>
          <p class="text-sm text-[#5D4E44] mt-2 leading-relaxed pl-6">
            Para boxes de desayuno sugerimos 24 hs de anticipación. Para tortas de cumpleaños y festejos recomendamos 48 hs, y para catering de eventos grandes solicitamos 72 hs previas.
          </p>
        </div>

        <div class="bg-[#F4EFEB] p-6 rounded-2xl border border-[#87786F]/20">
          <h3 class="font-bold text-base text-[#3F2B1F] flex items-center gap-2">
            <HelpCircle className="w-4 h-4 text-[#A66B38] shrink-0" />
            <span>¿A qué localidades del Partido de La Costa hacen delivery?</span>
          </h3>
          <p class="text-sm text-[#5D4E44] mt-2 leading-relaxed pl-6">
            Llegamos a Santa Teresita, Mar del Tuyú, Costa del Este, Aguas Verdes, La Lucila del Mar, Costa Azul, San Bernardo y Mar de Ajó con repartos programados en turnos mañana y tarde.
          </p>
        </div>

        <div class="bg-[#F4EFEB] p-6 rounded-2xl border border-[#87786F]/20">
          <h3 class="font-bold text-base text-[#3F2B1F] flex items-center gap-2">
            <HelpCircle className="w-4 h-4 text-[#A66B38] shrink-0" />
            <span>¿Qué medios de pago aceptan?</span>
          </h3>
          <p class="text-sm text-[#5D4E44] mt-2 leading-relaxed pl-6">
            Aceptamos efectivo en el local o al recibir tu pedido, transferencias bancarias directas y transferencias por Mercado Pago.
          </p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
